#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
content="$root/skills"
dry=0
if [ "${1:-}" = "--dry-run" ]; then dry=1; fi

run() {
  echo "+ $*"
  if [ "$dry" = 0 ]; then "$@"; fi
}

refuse() {
  echo "REFUSE $1: $2" >&2
  exit 1
}

link_provider() {
  base=$1
  if [ -L "$base" ]; then
    echo "unwrap $base ($(readlink "$base")) -> real dir with per-skill links"
    if [ "$dry" = 1 ]; then
      for skill in "$content"/*; do
        echo "link $base/$(basename "$skill") -> $skill"
      done
      return 0
    fi
    rm "$base"
  elif [ -d "$base" ]; then
    :
  elif [ -e "$base" ]; then
    refuse "$base" "not a directory or symlink"
  fi
  run mkdir -p "$base"
  linked=" "
  for skill in "$content"/*; do
    name=$(basename "$skill")
    link="$base/$name"
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$skill" ]; then
      echo "ok   $link"
    elif [ -L "$link" ]; then
      echo "relink $link ($(readlink "$link"))"
      run ln -sfn "$skill" "$link"
    elif [ -e "$link" ]; then
      refuse "$link" "real file or directory in the way"
    else
      echo "link $link -> $skill"
      run ln -s "$skill" "$link"
    fi
    linked="$linked$name "
  done
  for link in "$base"/*; do
    [ -L "$link" ] || continue
    name=$(basename "$link")
    case "$linked" in
      *" $name "*) continue ;;
    esac
    [ -d "$content/$name" ] || refuse "$base" "symlink $name is not backed by the skills repo; remove it or add the skill"
    [ "$(readlink "$link")" = "$content/$name" ] || { echo "prune-stale $link"; run rm "$link"; }
  done
}

[ -d "$content" ] || refuse "$content" "skills content directory missing"

link_provider "$HOME/.agents/skills"
link_provider "$HOME/.claude/skills"
link_provider "$HOME/.codex/skills"
echo "skills linked"
